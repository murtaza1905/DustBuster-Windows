<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DustBuster.Core</RootNamespace>
    <AssemblyName>DustBuster.Core</AssemblyName>
    <Description>UI-independent matching and cleanup rules for DustBuster for Windows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\conditions.json" LogicalName="conditions.json" />
    <EmbeddedResource Include="Resources\rules.json" LogicalName="rules.json" />
  </ItemGroup>

</Project>
