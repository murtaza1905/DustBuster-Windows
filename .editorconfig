root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_size = 2

[*.{ps1,psm1}]
end_of_line = crlf

[*.cs]
csharp_new_line_before_open_brace = all
csharp_prefer_braces = when_multiline
dotnet_sort_system_directives_first = true

[*.sln]
end_of_line = crlf
